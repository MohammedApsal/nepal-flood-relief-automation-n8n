    {
      "parameters": {
        "jsCode": "const item = items[0].json;\nconst errors = [];\n\nconst fullName = (item.full_name || '').trim();\nif (fullName.length < 2) errors.push('full_name');\n\nconst ward = (item.ward_or_village || '').trim();\nif (ward.length < 2) errors.push('ward_or_village');\n\nconst district = (item.district || '').trim();\nif (district.length < 2) errors.push('district');\n\n// Normalize Nepal Phone Number to E.164 (+977...)\nlet rawPhone = String(item.phone || '').trim().replace(/[\\s\\-\\(\\)]/g, '');\nlet normalizedPhone = '';\n\nif (rawPhone.startsWith('+977')) {\n  normalizedPhone = rawPhone;\n} else if (rawPhone.startsWith('977')) {\n  normalizedPhone = '+' + rawPhone;\n} else if (/^9[78]\\d{8}$/.test(rawPhone)) {\n  normalizedPhone = '+977' + rawPhone;\n} else if (/^0\\d{8,9}$/.test(rawPhone)) {\n  normalizedPhone = '+977' + rawPhone.replace(/^0/, '');\n} else if (/^\\+?[1-9]\\d{7,14}$/.test(rawPhone)) {\n  normalizedPhone = rawPhone.startsWith('+') ? rawPhone : '+' + rawPhone;\n}\n\nif (!normalizedPhone) {\n  errors.push('phone (requires valid Nepal number)');\n}\n\n// Need categorization & urgency\nconst allowedNeeds = ['food', 'shelter', 'medical', 'rescue', 'water', 'clothing', 'other'];\nconst needType = (item.need_type || '').toLowerCase().trim();\nconst normalizedNeed = allowedNeeds.includes(needType) ? needType : 'other';\n\nlet urgency = 'normal';\nif (['rescue', 'medical'].includes(normalizedNeed)) {\n  urgency = 'critical';\n} else if (['food', 'water', 'shelter'].includes(normalizedNeed)) {\n  urgency = 'high';\n}\n\nreturn [{\n  json: {\n    ...item,\n    full_name: fullName,\n    phone: rawPhone,\n    phone_e164: normalizedPhone,\n    ward_or_village: ward,\n    district: district,\n    need_type: normalizedNeed,\n    urgency: urgency,\n    is_valid: errors.length === 0,\n    validation_errors: errors,\n    request_id: 'NPL-' + Date.now().toString(36).toUpperCase() + '-' + Math.floor(100 + Math.random() * 900)\n  }\n}];"
      },
